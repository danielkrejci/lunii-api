{
    "name": "lunii-api",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "clean-install": "PYTHON=$(brew --prefix python@3.11)/bin/python3.11 pnpm install",
        "reinstall": "rm -rf node_modules pnpm-lock.yaml && PYTHON=$(brew --prefix python@3.11)/bin/python3.11 pnpm install",
        "dev": "tsx watch src/index.ts",
        "build": "pnpm exec tsc",
        "migrate": "tsx dist/migrate.js",
        "start": "tsx dist/index.js",
        "start:prod": "pnpm migrate && pnpm start",
        "depcheck": "depcheck",
        "db:generate": "npx drizzle-kit generate",
        "db:migrate": "npx drizzle-kit migrate",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "prepare": "husky"
    },
    "dependencies": {
        "@better-auth/expo": "^1.6.19",
        "@fastify/autoload": "^6.3.1",
        "@fastify/cors": "^11.2.0",
        "@fastify/formbody": "^8.0.2",
        "@fastify/multipart": "^10.0.0",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/schedule": "^6.0.0",
        "@google/genai": "^1.52.0",
        "@placekit/client-js": "^2.3.0",
        "@t3-oss/env-nextjs": "^0.13.11",
        "better-auth": "^1.6.19",
        "dayjs": "^1.11.21",
        "dotenv": "^17.4.2",
        "drizzle-orm": "0.45.2",
        "fastify": "^5.8.5",
        "fastify-plugin": "^5.1.0",
        "fastify-type-provider-zod": "^6.1.0",
        "geo-tz": "^8.1.7",
        "pg": "^8.21.0",
        "postgres": "^3.4.9",
        "swisseph": "^0.5.17",
        "toad-scheduler": "^3.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.1.0",
        "@commitlint/config-conventional": "^21.1.0",
        "@types/pg": "^8.20.0",
        "drizzle-kit": "0.31.10",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "oxfmt": "^0.55.0",
        "oxlint": "^1.70.0",
        "pino-pretty": "^13.1.3",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "oxlint --fix",
            "oxfmt"
        ]
    },
    "engines": {
        "node": "22.x",
        "pnpm": "11.x"
    },
    "packageManager": "pnpm@11.5.1"
}
