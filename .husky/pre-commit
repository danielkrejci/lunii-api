# Git hooks run without a login shell, so nvm is not on PATH and the system
# node (v20.9) gets picked up — too old for oxlint. Load nvm and honour .nvmrc.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
	. "$NVM_DIR/nvm.sh" --no-use
	nvm use >/dev/null || nvm use default >/dev/null
fi

npx lint-staged
npx tsc
